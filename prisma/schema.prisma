generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  premium
}

model UserProfile {
  id                       String       @id @default(cuid())
  clerkUserId              String       @unique
  displayName              String
  avatarKey                String       @default("Joyful Jump")
  skinKey                  String       @default("default")
  unlockedCosmetics        Json         @default("[]")
  credits                  Int          @default(0)
  plan                     Plan         @default(free)
  stripeCustomerId         String?      @unique
  stripeSubscriptionId     String?      @unique
  stripeSubscriptionStatus String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  gameResults              GameResult[]
  favorites                Favorite[]
}

model GameResult {
  id       String      @id @default(cuid())
  userId   String
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode     String
  roomCode String
  score    Int
  rank     Int
  playedAt DateTime    @default(now())
  summary  Json?

  @@index([userId, playedAt])
}

model Favorite {
  id         String      @id @default(cuid())
  userId     String
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  createdAt  DateTime    @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

/** Community difficulty: up = harder (+1), down = easier (-1). */
model QuestionDifficultyVote {
  id         String   @id @default(cuid())
  questionId String
  playerKey  String
  delta      Int
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([questionId, playerKey])
  @@index([questionId])
}

/** Cached sum of difficulty votes for fast filtering. */
model QuestionDifficultyScore {
  questionId  String   @id
  score       Int      @default(0)
  upVotes     Int      @default(0)
  downVotes   Int      @default(0)
  reportCount Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/** Player flagged a bad / wrong question — review in Prisma Studio or /api/admin/question-reports. */
model QuestionErrorReport {
  id           String   @id @default(cuid())
  questionId   String
  playerKey    String
  mode         String   @default("classic")
  questionText String?
  note         String?
  optionsJson  Json?
  correctIndex Int?
  createdAt    DateTime @default(now())

  @@unique([questionId, playerKey])
  @@index([createdAt])
  @@index([questionId])
}
