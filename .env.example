# Real-time game server (Next.js rewrites / socket client)
QUIZIN_SOCKET_URL=http://127.0.0.1:4000

# --- Production (Vercel + Render) ---
# Vercel: set NEXT_PUBLIC_SOCKET_URL to your Render Web Service URL.
# Render: set NEXT_PUBLIC_APP_ORIGIN to your Vercel URL(s), comma-separated.
# Leave NEXT_PUBLIC_SOCKET_URL unset in local dev to use 127.0.0.1:4000.
# NEXT_PUBLIC_SOCKET_URL=https://quizin-socket.onrender.com

# Extra allowed CORS origins for the socket server (comma-separated)
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# Public canonical URL for SEO (no trailing slash). On Vercel use the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console → HTML tag verification (content value only)
# GOOGLE_SITE_VERIFICATION=your-token-here
#
# Google Analytics (GA4) measurement id. Leave empty to disable analytics.
# Example: NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# --- Auth (Clerk) ---
# Create an application at https://dashboard.clerk.com
# Without these keys the site still works for guests; sign-in is hidden.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Neon Postgres) ---
# https://neon.tech → connection string
# Required for profiles, history, favorites, credits.
DATABASE_URL=

# --- Billing (Stripe — direct, not Clerk Billing) ---
# Dashboard: https://dashboard.stripe.com (use test mode first)
# 1. Create Product "QuizIn Premium" + recurring Price: 5.00 EUR / month
# 2. Copy Price ID → STRIPE_PRICE_PREMIUM_MONTHLY
# 3. Developers → API keys → secret + publishable
# 4. Webhook → https://<your-domain>/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#            customer.subscription.deleted, invoice.paid, invoice.payment_failed
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
